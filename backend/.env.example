# Application environment: development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=5000

# MongoDB connection string (required — no default)
# Local example: mongodb://127.0.0.1:27017/service-when-need
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/service-when-need

# Auth
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Tests only. Must point to a DIFFERENT database than MONGODB_URI, and its name must end in "_test".
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/service-when-need_test
